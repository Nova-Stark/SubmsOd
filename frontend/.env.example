# Brightloop Platform Frontend Environment Configuration

# API Base URL (Point to backend Go/Gin core server)
VITE_API_URL=http://localhost:8080/api/v1

# Enable in-memory mock engine for frontend prototyping and automated preview (true/false)
VITE_USE_MOCK=true

# Auth storage strategy: 'cookie' (withCredentials httpOnly cookie) or 'localStorage'
VITE_AUTH_STORAGE=cookie

# Default currency configuration
VITE_DEFAULT_CURRENCY=INR
VITE_DEFAULT_LOCALE=en-IN
